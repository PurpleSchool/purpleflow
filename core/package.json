{
  "name": "@psflow/core",
  "version": "0.1.0",
  "description": "PurpleFlow orchestrator core: stages, gates, agents. No Electron dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "prompts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
