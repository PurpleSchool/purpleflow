{
  "name": "purpleflow",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "core",
    "app"
  ],
  "scripts": {
    "build:core": "npm run build -w @purpleflow/core",
    "dev": "npm run dev -w @purpleflow/app",
    "build": "npm run build -w @purpleflow/core && npm run build -w @purpleflow/app",
    "typecheck": "npm run typecheck -w @purpleflow/core && npm run typecheck -w @purpleflow/app",
    "test": "npm test -w @purpleflow/core && npm test -w @purpleflow/app",
    "test:e2e": "npm run test:e2e -w @purpleflow/app",
    "make-sample": "node scripts/make-sample.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT"
}
