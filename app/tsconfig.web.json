{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@purpleflow/core": ["../core/src/types.ts"],
      "@purpleflow/route": ["../core/src/route.ts"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts", "../core/src/route.ts", "../core/src/modes.ts"],
  "exclude": ["src/renderer/src/**/*.test.ts"]
}
