{
  "name": "@purpleflow/app",
  "productName": "PurpleFlow",
  "desktopName": "purpleflow.desktop",
  "version": "0.3.1",
  "description": "PurpleFlow — оркестратор стадий для claude и codex на OpenSpec",
  "author": "PurpleSchool",
  "homepage": "https://purpleschool.ru",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --tsconfig tsconfig.web.json --test \"src/**/*.test.ts\"",
    "test:e2e": "electron-vite build && playwright test",
    "screenshots": "electron-vite build && PURPLEFLOW_SHOTS=1 playwright test screenshots",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.1",
    "@purpleflow/core": "*",
    "@sentry/electron": "^8.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
