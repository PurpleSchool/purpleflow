{
  "name": "@purpleflow/installer",
  "productName": "Установщик PurpleFlow",
  "version": "0.11.0",
  "description": "Установщик PurpleFlow: ставит приложение и всё, что ему нужно, без терминала",
  "author": "PurpleSchool",
  "homepage": "https://purpleschool.ru",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --tsconfig tsconfig.node.json --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "dist:mac": "electron-vite build && node scripts/dist.mjs --mac",
    "dist:win": "electron-vite build && node scripts/dist.mjs --win",
    "dist:linux": "electron-vite build && node scripts/dist.mjs --linux",
    "dist:dir": "electron-vite build && node scripts/dist.mjs --dir",
    "release:mac": "node scripts/release-mac.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@purpleflow/core": "*",
    "@types/node": "^22.10.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
